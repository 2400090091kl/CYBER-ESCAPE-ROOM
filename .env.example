# OPERATION SHADOWBYTE - Server Environment Configuration Template
# Copy this file to .env and adjust secrets as appropriate

PORT=3001

# Organizer Authentication Credentials
ORGANIZER_USERNAME=admin
ORGANIZER_PASSWORD=your_secure_organizer_password_here

# JWT Token Secret Key for Signed Organizer Sessions
JWT_SECRET=your_random_secret_token_here

# Optional: Supabase Database Synchronization (Free Tier)
# If provided, team registrations, submissions, and scores will sync to your Supabase tables.
# If omitted, the server uses local file-backed persistence (server/data/store.json).
SUPABASE_URL=
SUPABASE_KEY=

